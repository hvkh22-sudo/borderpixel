# Public, client-side configuration (embedded in the app bundle — no secrets here).
# RevenueCat *public* SDK keys (safe to ship in apps).
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# Base URL of the deployed AI proxy (server/). Leave empty to disable AI Studio.
EXPO_PUBLIC_AI_BASE_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Feature flags: set to "off" to disable; burn-in requires "on".
EXPO_PUBLIC_FLAG_VOICE_FOLLOW=
EXPO_PUBLIC_FLAG_CAPTIONS=
EXPO_PUBLIC_FLAG_BURN_IN=
EXPO_PUBLIC_FLAG_AI_STUDIO=
